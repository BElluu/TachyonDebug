{
  "name": "Friend request: send, accept, remove",
  "category": "Friends",
  "description": "player1 asks, player2 accepts, then player1 removes the friend.  Based on: friend_test.exs (friend request lifecycle, removing).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "friend/remove",
      "title": "Reset: player1 unfriends player2",
      "data": {
        "userId": "${player2.id}"
      },
      "optional": true
    },
    {
      "as": "player2",
      "command": "friend/remove",
      "title": "Reset: player2 unfriends player1",
      "data": {
        "userId": "${player1.id}"
      },
      "optional": true
    },
    {
      "as": "player1",
      "command": "friend/cancelRequest",
      "title": "Reset: cancel pending requests",
      "data": {
        "to": "${player2.id}"
      },
      "optional": true
    },
    {
      "as": "player2",
      "command": "friend/cancelRequest",
      "data": {
        "to": "${player1.id}"
      },
      "optional": true
    },
    {
      "sleep": 300
    },
    {
      "drain": "all"
    },
    {
      "as": "player1",
      "command": "friend/sendRequest",
      "title": "player1 sends a request",
      "data": {
        "to": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "friend/requestReceived",
      "title": "player2 receives it"
    },
    {
      "as": "player2",
      "command": "friend/acceptRequest",
      "title": "player2 accepts",
      "data": {
        "from": "${player1.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "friend/requestAccepted",
      "title": "player1 is told"
    },
    {
      "as": "player1",
      "command": "friend/list",
      "title": "player1's friend list",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "friend/remove",
      "title": "player1 removes player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "friend/removed",
      "title": "player2 is told"
    }
  ]
}
