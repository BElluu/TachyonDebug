{
  "name": "Last member leaving removes pending invites",
  "category": "Party",
  "description": "player1 and player2 are in a party, player3 is invited. When everybody leaves, player3's invite is removed.  Based on: party_test.exs (disconnections: last member leaving notifies invited).",
  "sessions": [
    "player1",
    "player2",
    "player3"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player3",
      "command": "matchmaking/cancel",
      "title": "Reset: player3 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "as": "player3",
      "command": "party/leave",
      "title": "Reset: player3 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player3",
      "data": {
        "userId": "${player3.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player3",
      "waitFor": "party/invited",
      "title": "player3 receives the invite"
    },
    {
      "drain": "all"
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "player2 leaves",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "player1 (last member) leaves",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player3",
      "waitFor": "party/removed",
      "title": "player3 is told the party is gone"
    }
  ]
}
