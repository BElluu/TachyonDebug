{
  "name": "Kick a member",
  "category": "Party",
  "description": "player1 kicks player2 out of the party.  Based on: party_test.exs (kick player: works).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "drain": "all"
    },
    {
      "as": "player1",
      "command": "party/kickMember",
      "title": "player1 kicks player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "player1 sees the updated party"
    },
    {
      "as": "player2",
      "waitFor": "party/removed",
      "title": "player2 is told he was removed"
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
