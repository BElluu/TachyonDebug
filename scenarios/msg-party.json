{
  "name": "Party chat",
  "category": "Messaging",
  "description": "player1 writes to the party; player2 receives it with a party source.  Based on: messaging_test.exs (messaging in party).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "command": "messaging/subscribeReceived",
      "title": "player2 subscribes",
      "expect": {
        "status": "success"
      },
      "data": {
        "since": {
          "type": "latest"
        }
      }
    },
    {
      "drain": "all"
    },
    {
      "as": "player1",
      "command": "messaging/send",
      "title": "player1 writes to the party",
      "data": {
        "target": {
          "type": "party"
        },
        "message": "hello party"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "messaging/received",
      "title": "player2 receives it",
      "expect": {
        "data": {
          "message": "hello party",
          "source": {
            "type": "party",
            "partyId": "${party.id}"
          }
        }
      }
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Cleanup: player2 leaves the party",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
