{
  "name": "Leaving the party cancels matchmaking",
  "category": "Matchmaking",
  "description": "bob leaves the party while it is queued; both get matchmaking/cancelled with party_user_left.  Based on: party_matchmaking_test.exs (one member leaving the party makes all member leave mm).",
  "sessions": [
    "alice",
    "bob"
  ],
  "steps": [
    {
      "as": "alice",
      "command": "matchmaking/cancel",
      "title": "Reset: alice leaves matchmaking",
      "optional": true
    },
    {
      "as": "bob",
      "command": "matchmaking/cancel",
      "title": "Reset: bob leaves matchmaking",
      "optional": true
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Reset: alice leaves any party",
      "optional": true
    },
    {
      "as": "bob",
      "command": "party/leave",
      "title": "Reset: bob leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "alice",
      "command": "matchmaking/list",
      "title": "Find a 2v2 queue (teamSize 2)",
      "expect": {
        "status": "success"
      },
      "capture": {
        "queue": "data.playlists.teamSize=2"
      }
    },
    {
      "as": "alice",
      "command": "party/create",
      "title": "alice creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "alice",
      "command": "party/invite",
      "title": "alice invites bob",
      "data": {
        "userId": "${bob.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "party/invited",
      "title": "bob receives the invite"
    },
    {
      "as": "bob",
      "command": "party/acceptInvite",
      "title": "bob accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "alice",
      "command": "matchmaking/queue",
      "title": "alice queues the party",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "matchmaking/queuesJoined",
      "title": "bob is told the party joined"
    },
    {
      "drain": "all"
    },
    {
      "as": "bob",
      "command": "party/leave",
      "title": "bob leaves the party",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "matchmaking/cancelled",
      "title": "bob is out of matchmaking",
      "expect": {
        "data": {
          "reason": "party_user_left"
        }
      }
    },
    {
      "as": "alice",
      "waitFor": "matchmaking/cancelled",
      "title": "alice is out of matchmaking too",
      "expect": {
        "data": {
          "reason": "party_user_left"
        }
      }
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Cleanup: alice leaves the party",
      "optional": true
    }
  ]
}
