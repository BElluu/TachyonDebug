{
  "name": "Unknown command is answered with a failure",
  "category": "Robustness",
  "description": "A well-formed request for a command that does not exist must get a failed response with the same messageId, not silence.",
  "sessions": [
    "player1"
  ],
  "steps": [
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "raw": {
        "type": "request",
        "messageId": "raw-unknown-1",
        "commandId": "does/notExist"
      },
      "waitReply": true,
      "expect": {
        "type": "response",
        "messageId": "raw-unknown-1",
        "status": "failed"
      },
      "title": "player1 requests does/notExist"
    },
    {
      "as": "player1",
      "reconnect": "ifClosed",
      "title": "player1 reconnects if the server dropped the connection"
    },
    {
      "as": "player1",
      "command": "system/serverStats",
      "title": "The server still answers normal requests",
      "expect": {
        "status": "success"
      }
    }
  ]
}
