{
  "name": "Friend request: cancel",
  "category": "Friends",
  "description": "player1 withdraws her request before player2 answers.  Based on: friend_test.exs (can cancel request).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "friend/remove",
      "title": "Reset: player1 unfriends player2",
      "data": {
        "userId": "${player2.id}"
      },
      "optional": true
    },
    {
      "as": "player2",
      "command": "friend/remove",
      "title": "Reset: player2 unfriends player1",
      "data": {
        "userId": "${player1.id}"
      },
      "optional": true
    },
    {
      "as": "player1",
      "command": "friend/cancelRequest",
      "title": "Reset: cancel pending requests",
      "data": {
        "to": "${player2.id}"
      },
      "optional": true
    },
    {
      "as": "player2",
      "command": "friend/cancelRequest",
      "data": {
        "to": "${player1.id}"
      },
      "optional": true
    },
    {
      "sleep": 300
    },
    {
      "drain": "all"
    },
    {
      "as": "player1",
      "command": "friend/sendRequest",
      "title": "player1 sends a request",
      "data": {
        "to": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "friend/requestReceived",
      "title": "player2 receives it"
    },
    {
      "as": "player1",
      "command": "friend/cancelRequest",
      "title": "player1 cancels",
      "data": {
        "to": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "friend/requestCancelled",
      "title": "player2 is told"
    }
  ]
}
