{
  "name": "Friend request: cancel",
  "category": "Friends",
  "description": "alice withdraws her request before bob answers.  Based on: friend_test.exs (can cancel request).",
  "sessions": [
    "alice",
    "bob"
  ],
  "steps": [
    {
      "as": "alice",
      "command": "friend/remove",
      "title": "Reset: alice unfriends bob",
      "data": {
        "userId": "${bob.id}"
      },
      "optional": true
    },
    {
      "as": "bob",
      "command": "friend/remove",
      "title": "Reset: bob unfriends alice",
      "data": {
        "userId": "${alice.id}"
      },
      "optional": true
    },
    {
      "as": "alice",
      "command": "friend/cancelRequest",
      "title": "Reset: cancel pending requests",
      "data": {
        "to": "${bob.id}"
      },
      "optional": true
    },
    {
      "as": "bob",
      "command": "friend/cancelRequest",
      "data": {
        "to": "${alice.id}"
      },
      "optional": true
    },
    {
      "sleep": 300
    },
    {
      "drain": "all"
    },
    {
      "as": "alice",
      "command": "friend/sendRequest",
      "title": "alice sends a request",
      "data": {
        "to": "${bob.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "friend/requestReceived",
      "title": "bob receives it"
    },
    {
      "as": "alice",
      "command": "friend/cancelRequest",
      "title": "alice cancels",
      "data": {
        "to": "${bob.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "friend/requestCancelled",
      "title": "bob is told"
    }
  ]
}
