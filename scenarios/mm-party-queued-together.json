{
  "name": "A party queues together",
  "category": "Matchmaking",
  "description": "player1 and player2 form a party. When player1 queues, player2 is queued too; when player1 cancels, player2 is told.  Based on: party_matchmaking_test.exs (all members join matchmaking, one member leaving matchmaking).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "matchmaking/list",
      "title": "Find a 2v2 queue (teamSize 2)",
      "expect": {
        "status": "success"
      },
      "capture": {
        "queue": "data.playlists.teamSize=2"
      }
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "drain": "all"
    },
    {
      "as": "player1",
      "command": "matchmaking/queue",
      "title": "player1 queues the party",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "matchmaking/queuesJoined",
      "title": "player2 is told the party joined"
    },
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "player1 cancels",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "matchmaking/cancelled",
      "title": "player2 is told it was cancelled"
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Cleanup: player2 leaves the party",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
