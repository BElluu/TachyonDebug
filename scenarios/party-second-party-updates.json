{
  "name": "Regression: updates after joining a second party",
  "category": "Party",
  "description": "A player who leaves a party and then creates a new one must still receive party/updated. Known server bug: the player session keeps the old party's version and silently drops updates until the new party catches up. Found while running the other party scenarios.",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "Party 1: player1 creates it",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "Party 1: player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "Party 1: player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/declineInvite",
      "title": "Party 1: player2 declines (raises the party version)",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "Party 1: player1 is told (updates still work)"
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "player1 leaves party 1",
      "expect": {
        "status": "success"
      }
    },
    {
      "sleep": 300,
      "title": "Let the events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "Party 2: player1 creates a fresh party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "Party 2: player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "Party 2: player2 receives the invite"
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "Party 2: player1 must be told about the invite",
      "timeout": 2000,
      "note": "Fails on servers where the player session keeps the previous party's version and drops lower-versioned updates."
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves",
      "optional": true
    }
  ]
}
