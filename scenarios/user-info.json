{
  "name": "User info",
  "category": "User",
  "description": "player1 asks for player2's public info; an unknown id fails with unknown_user.  Based on: user_test.exs (info).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "user/info",
      "title": "info about player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "user/info",
      "title": "info about an unknown user",
      "data": {
        "userId": "999999999"
      },
      "expect": {
        "status": "failed",
        "reason": "unknown_user"
      }
    }
  ]
}
