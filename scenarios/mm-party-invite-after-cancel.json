{
  "name": "Party can invite again after cancelling matchmaking (#1475)",
  "category": "Matchmaking",
  "description": "Regression check for a party stuck in 'in matchmaking' after a cancel: invites and queueing must work again.",
  "issue": "https://github.com/beyond-all-reason/teiserver/issues/1475",
  "sessions": [
    "player1",
    "player2",
    "player3"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player3",
      "command": "matchmaking/cancel",
      "title": "Reset: player3 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "as": "player3",
      "command": "party/leave",
      "title": "Reset: player3 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "matchmaking/list",
      "title": "Find a 2v2 queue (teamSize 2)",
      "expect": {
        "status": "success"
      },
      "capture": {
        "queue": "data.playlists.teamSize=2"
      }
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/queue",
      "title": "player1 queues the party",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "player1 cancels",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "matchmaking/cancelled",
      "title": "player2 is told"
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "inviting must work again (was party_in_matchmaking)",
      "data": {
        "userId": "${player3.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/queue",
      "title": "queueing must work again",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Cleanup: leave the queue",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Cleanup: player2 leaves the party",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
