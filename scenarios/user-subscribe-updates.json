{
  "name": "Subscribe to a user's updates",
  "category": "User",
  "description": "Subscribing answers with the current state in a user/updated event.  Based on: user_test.exs (updates: for online user).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "user/subscribeUpdates",
      "title": "player1 subscribes to player2",
      "data": {
        "userIds": [
          "${player2.id}"
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "user/updated",
      "title": "player1 gets player2's full state",
      "expect": {
        "data": {
          "users": [
            {
              "username": "${player2.name}"
            }
          ]
        }
      }
    },
    {
      "as": "player1",
      "command": "user/unsubscribeUpdates",
      "title": "player1 unsubscribes",
      "data": {
        "userIds": [
          "${player2.id}"
        ]
      },
      "expect": {
        "status": "success"
      }
    }
  ]
}
