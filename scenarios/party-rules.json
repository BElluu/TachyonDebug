{
  "name": "Party rules: invalid requests are rejected",
  "category": "Party",
  "description": "Every call below must fail with invalid_request, as the server's tests expect.  Based on: party_test.exs (create, leave, invite lifecycle, kick player).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "leaving without a party",
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "inviting without a party",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/kickMember",
      "title": "kicking without a party",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "cannot create a second party",
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "cannot invite twice",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/kickMember",
      "title": "an invited player is not a valid kick target",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "accepting an unknown party",
      "data": {
        "partyId": "not-a-party"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
