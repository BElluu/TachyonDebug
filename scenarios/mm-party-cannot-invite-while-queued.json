{
  "name": "Cannot invite while the party is queued",
  "category": "Matchmaking",
  "description": "A party in matchmaking is locked: inviting fails with party_in_matchmaking until it cancels.  Based on: party_matchmaking_test.exs (cannot invite when in matchmaking).",
  "sessions": [
    "player1",
    "player2",
    "player3"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player3",
      "command": "matchmaking/cancel",
      "title": "Reset: player3 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "as": "player3",
      "command": "party/leave",
      "title": "Reset: player3 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "matchmaking/list",
      "title": "Find a 2v2 queue (teamSize 2)",
      "expect": {
        "status": "success"
      },
      "capture": {
        "queue": "data.playlists.teamSize=2"
      }
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/queue",
      "title": "player1 queues the party",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "invite is refused while queued",
      "data": {
        "userId": "${player3.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request",
        "details": ":party_in_matchmaking"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "player1 cancels",
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "invite works after the cancel",
      "data": {
        "userId": "${player3.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Cleanup: player2 leaves the party",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
