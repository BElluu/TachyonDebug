{
  "name": "Create a party, invite and accept",
  "category": "Party",
  "description": "alice creates a party, invites bob, bob accepts. Both sides must be told.  Based on: party_test.exs (invite lifecycle: works, accept invite works).  Note: can fail with a timeout on party/updated when this player was in an earlier party (see the regression scenario for the server bug).",
  "sessions": [
    "alice",
    "bob"
  ],
  "steps": [
    {
      "as": "alice",
      "command": "matchmaking/cancel",
      "title": "Reset: alice leaves matchmaking",
      "optional": true
    },
    {
      "as": "bob",
      "command": "matchmaking/cancel",
      "title": "Reset: bob leaves matchmaking",
      "optional": true
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Reset: alice leaves any party",
      "optional": true
    },
    {
      "as": "bob",
      "command": "party/leave",
      "title": "Reset: bob leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "alice",
      "command": "party/create",
      "title": "alice creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "alice",
      "command": "party/invite",
      "title": "alice invites bob",
      "data": {
        "userId": "${bob.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "party/invited",
      "title": "bob receives the invite",
      "expect": {
        "data": {
          "party": {
            "id": "${party.id}"
          }
        }
      }
    },
    {
      "as": "alice",
      "waitFor": "party/updated",
      "title": "alice is told about the pending invite"
    },
    {
      "drain": "all"
    },
    {
      "as": "bob",
      "command": "party/acceptInvite",
      "title": "bob accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "alice",
      "waitFor": "party/updated",
      "title": "alice sees bob join"
    },
    {
      "as": "bob",
      "waitFor": "party/updated",
      "title": "bob gets the party state"
    },
    {
      "as": "bob",
      "command": "party/leave",
      "title": "Cleanup: bob leaves the party",
      "optional": true
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Cleanup: alice leaves the party",
      "optional": true
    }
  ]
}
