{
  "name": "Create a party, invite and accept",
  "category": "Party",
  "description": "player1 creates a party, invites player2, player2 accepts. Both sides must be told.  Based on: party_test.exs (invite lifecycle: works, accept invite works).  Note: can fail with a timeout on party/updated when this player was in an earlier party (see the regression scenario for the server bug).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite",
      "expect": {
        "data": {
          "party": {
            "id": "${party.id}"
          }
        }
      }
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "player1 is told about the pending invite"
    },
    {
      "drain": "all"
    },
    {
      "as": "player2",
      "command": "party/acceptInvite",
      "title": "player2 accepts",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "player1 sees player2 join"
    },
    {
      "as": "player2",
      "waitFor": "party/updated",
      "title": "player2 gets the party state"
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Cleanup: player2 leaves the party",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
