{
  "name": "Party: create and invite",
  "description": "alice creates a party and invites bob. Needs sessions 'alice' and 'bob'.",
  "sessions": ["alice", "bob"],
  "steps": [
    { "as": "alice", "command": "party/create", "expect": { "status": "success" } },
    { "as": "alice", "command": "party/invite", "data": { "userId": "${bob.id}" }, "expect": { "status": "success" } },
    { "as": "bob", "waitFor": "party/invited" }
  ]
}
