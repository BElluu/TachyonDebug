{
  "name": "Direct message",
  "category": "Messaging",
  "description": "player2 subscribes to messages, player1 writes to player2.  Based on: messaging_test.exs (send with subscribe latest).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player2",
      "command": "messaging/subscribeReceived",
      "title": "player2 subscribes",
      "expect": {
        "status": "success"
      },
      "data": {
        "since": {
          "type": "latest"
        }
      }
    },
    {
      "as": "player1",
      "command": "messaging/send",
      "title": "player1 sends a DM",
      "data": {
        "target": {
          "type": "player",
          "userId": "${player2.id}"
        },
        "message": "GL HF"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "messaging/received",
      "title": "player2 receives it",
      "expect": {
        "data": {
          "message": "GL HF",
          "source": {
            "type": "player",
            "userId": "${player1.id}"
          }
        }
      }
    }
  ]
}
