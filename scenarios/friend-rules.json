{
  "name": "Friend request: invalid requests",
  "category": "Friends",
  "description": "Sending to yourself or to an unknown user is rejected with invalid_user.  Based on: friend_test.exs (request non-existent user, request to self).",
  "sessions": [
    "player1"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "friend/sendRequest",
      "title": "request to yourself",
      "data": {
        "to": "${player1.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_user"
      }
    },
    {
      "as": "player1",
      "command": "friend/sendRequest",
      "title": "request to an unknown user",
      "data": {
        "to": "-37189312"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_user"
      }
    },
    {
      "as": "player1",
      "command": "friend/cancelRequest",
      "title": "cancel for an invalid user",
      "data": {
        "to": "invalid-id"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_user"
      }
    }
  ]
}
