{
  "name": "Two players get matched",
  "category": "Matchmaking",
  "description": "player1 and player2 join the same 1v1 queue; the queue ticks (every 5s by default) and both get matchmaking/found.  Based on: matchmaking_test.exs (pairing: get found events).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "matchmaking/list",
      "title": "Find a 1v1 queue (teamSize 1)",
      "expect": {
        "status": "success"
      },
      "capture": {
        "queue": "data.playlists.teamSize=1"
      }
    },
    {
      "as": "player1",
      "command": "matchmaking/queue",
      "title": "player1 joins",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "command": "matchmaking/queue",
      "title": "player2 joins",
      "data": {
        "queues": [
          {
            "id": "${queue.id}",
            "version": "${queue.version}"
          }
        ]
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "matchmaking/found",
      "title": "player1 is matched",
      "timeout": 20000
    },
    {
      "as": "player2",
      "waitFor": "matchmaking/found",
      "title": "player2 is matched",
      "timeout": 20000
    },
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Cleanup: player1 leaves",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Cleanup: player2 leaves",
      "optional": true
    }
  ]
}
