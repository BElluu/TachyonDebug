{
  "name": "Decline an invite",
  "category": "Party",
  "description": "bob declines; alice is told; declining again fails.  Based on: party_test.exs (can decline, cannot decline invite if not invited).",
  "sessions": [
    "alice",
    "bob"
  ],
  "steps": [
    {
      "as": "alice",
      "command": "matchmaking/cancel",
      "title": "Reset: alice leaves matchmaking",
      "optional": true
    },
    {
      "as": "bob",
      "command": "matchmaking/cancel",
      "title": "Reset: bob leaves matchmaking",
      "optional": true
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Reset: alice leaves any party",
      "optional": true
    },
    {
      "as": "bob",
      "command": "party/leave",
      "title": "Reset: bob leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "alice",
      "command": "party/create",
      "title": "alice creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "alice",
      "command": "party/invite",
      "title": "alice invites bob",
      "data": {
        "userId": "${bob.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "bob",
      "waitFor": "party/invited",
      "title": "bob receives the invite"
    },
    {
      "drain": "all"
    },
    {
      "as": "bob",
      "command": "party/declineInvite",
      "title": "bob declines",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "alice",
      "waitFor": "party/updated",
      "title": "alice sees the invite disappear"
    },
    {
      "as": "bob",
      "command": "party/declineInvite",
      "title": "declining twice is rejected",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "alice",
      "command": "party/leave",
      "title": "Cleanup: alice leaves the party",
      "optional": true
    }
  ]
}
