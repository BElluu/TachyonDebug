{
  "name": "Decline an invite",
  "category": "Party",
  "description": "player2 declines; player1 is told; declining again fails.  Based on: party_test.exs (can decline, cannot decline invite if not invited).",
  "sessions": [
    "player1",
    "player2"
  ],
  "steps": [
    {
      "as": "player1",
      "command": "matchmaking/cancel",
      "title": "Reset: player1 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player2",
      "command": "matchmaking/cancel",
      "title": "Reset: player2 leaves matchmaking",
      "optional": true
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Reset: player1 leaves any party",
      "optional": true
    },
    {
      "as": "player2",
      "command": "party/leave",
      "title": "Reset: player2 leaves any party",
      "optional": true
    },
    {
      "sleep": 300,
      "title": "Let the reset events settle"
    },
    {
      "drain": "all",
      "title": "Forget events received so far"
    },
    {
      "as": "player1",
      "command": "party/create",
      "title": "player1 creates a party",
      "expect": {
        "status": "success"
      },
      "capture": {
        "party": "data.party"
      }
    },
    {
      "as": "player1",
      "command": "party/invite",
      "title": "player1 invites player2",
      "data": {
        "userId": "${player2.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player2",
      "waitFor": "party/invited",
      "title": "player2 receives the invite"
    },
    {
      "drain": "all"
    },
    {
      "as": "player2",
      "command": "party/declineInvite",
      "title": "player2 declines",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "as": "player1",
      "waitFor": "party/updated",
      "title": "player1 sees the invite disappear"
    },
    {
      "as": "player2",
      "command": "party/declineInvite",
      "title": "declining twice is rejected",
      "data": {
        "partyId": "${party.id}"
      },
      "expect": {
        "status": "failed",
        "reason": "invalid_request"
      }
    },
    {
      "as": "player1",
      "command": "party/leave",
      "title": "Cleanup: player1 leaves the party",
      "optional": true
    }
  ]
}
